generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CEO
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DealStage {
  PROSPECTING
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  RENEWED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum AutomationStatus {
  ACTIVE
  PAUSED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  founderScore Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  employees    Employee[]
  deals        Deal[]
  approvals    Approval[]
  automations  Automation[]
  tickets      Ticket[]
  contracts    Contract[]
  vendors      Vendor[]
  notifications Notification[]
  activityLogs ActivityLog[]
  automationRuns AutomationRun[]
  issues        Issue[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  approvalsReq  Approval[]     @relation("ApprovalRequester")
  approvalsAct  Approval[]     @relation("ApprovalActor")
  notifications Notification[]
  activityLogs  ActivityLog[]
  ticketsOwned  Ticket[]       @relation("TicketAssignee")
  issuesRaised  Issue[]        @relation("IssueRaiser")
  issuesResolved Issue[]       @relation("IssueResolver")
}

model Membership {
  id             String  @id @default(cuid())
  userId         String
  organizationId String
  role           Role    @default(EMPLOYEE)
  department     String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Employee {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  title          String?
  department     String?
  email          String?
  status         EmploymentStatus @default(ACTIVE)
  engagement     Int              @default(70)
  attritionRisk  RiskLevel        @default(LOW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([department])
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  stage          DealStage @default(PROSPECTING)
  value          Float     @default(0)
  owner          String?
  winProbability Int       @default(20)
  closeDate      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stage])
}

model Approval {
  id             String         @id @default(cuid())
  organizationId String
  type           String
  department     String?
  title          String
  details        String?
  amount         Float?
  status         ApprovalStatus @default(PENDING)
  requesterId    String
  actorId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("ApprovalRequester", fields: [requesterId], references: [id])
  actor        User?        @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([organizationId, status])
}

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  trigger        String
  condition      String
  action         String
  status         AutomationStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
}

model AutomationRun {
  id             String   @id @default(cuid())
  organizationId String
  automationId   String
  status         String
  message        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  subject        String
  description    String?
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  assigneeId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId, status])
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  counterparty   String
  status         ContractStatus @default(DRAFT)
  value          Float?
  expiryDate     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  category       String?
  status         VendorStatus @default(PENDING)
  contractValue  Float?
  renewalDate    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  department     String?
  isRead         Boolean  @default(false)
  link           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String?
  entityId       String?
  meta           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}


model Issue {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String?
  department     String
  severity       IssueSeverity @default(MEDIUM)
  status         IssueStatus   @default(OPEN)
  raisedById     String?
  resolvedById   String?
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  raisedBy     User?        @relation("IssueRaiser", fields: [raisedById], references: [id])
  resolvedBy   User?        @relation("IssueResolver", fields: [resolvedById], references: [id])

  @@index([organizationId, department])
  @@index([organizationId, status])
}
